{
  "endpoints": {
    "following": "https://m.weibo.cn/api/container/getIndex?containerid=231093_-_selffollowed_-_{uid}&page={page}",
    "following_candidates": [
      "https://weibo.com/ajax/friendships/friends?page={page}&uid={uid}",
      "https://m.weibo.cn/api/container/getIndex?containerid=231093_-_selffollowed_-_{uid}&page={page}",
      "https://m.weibo.cn/api/container/getIndex?containerid=231051_-_followers_-_{uid}&page={page}",
      "https://m.weibo.cn/api/container/getIndex?containerid=231051_-_fans_-_{uid}&page={page}"
    ]
  },
  "headers": {
    "Accept": "application/json, text/plain, */*",
    "Referer": "https://m.weibo.cn/",
    "X-Requested-With": "XMLHttpRequest"
  },
  "sleep_range": [3, 5],
  "limits": {
    "max_pages": 20,
    "max_following_per_user": 200
  },
  "timeouts": {
    "http_timeout_sec": 20
  }
}
