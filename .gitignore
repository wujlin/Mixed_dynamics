# ============================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ============================================
# Jupyter
# ============================================
.ipynb_checkpoints/

# ============================================
# 数据集（隐私保护 + 大文件）
# ============================================
# 原始数据集（包含用户信息）
dataset/
data/raw/
# 标注数据（大文件）
outputs/annotations/
# LLM 验证数据（包含原始文本）
outputs/llm_validation/
# 用户元数据
*user_meta*.csv
*user_info*.csv
*uid*.csv

# ============================================
# Secrets / Cookies（隐私保护）
# ============================================
secrets/
cookies*.json
data/config/cookies*.json
data/config/*cookies*.json
data/config/*token*.json
data/config/*secrets*.json
*.key
*.pem

# ============================================
# 论文相关（版权保护）
# ============================================
# Essay 文件夹（投稿前的工作版本）
Essay/
# Essay_nc 文件夹（投稿版本）
Essay_nc/
# 编译好的论文 PDF
Manuscript*.pdf
Manuscript*.docx
# 论文 ZIP 包
*.zip
# 提交材料
submit_materials/
# 投稿指南
*submission-guide*.pdf
*editorial-policy*.pdf

# 但保留 references.bib（公开引用）
!references.bib

# ============================================
# 图表输出（生成文件）
# ============================================
outputs/figs/
outputs/tmp*.pdf
outputs/tmp*.png

# ============================================
# 开发文档（内部使用）
# ============================================
AGENTS.md
docs/internal/
docs/progress.md
docs/review.md
docs/email_*.md
docs/*_live.md
docs/*_report.md
docs/batch*_analysis.md
docs/writing_drills.md
docs/writing_pitfalls.md

# ============================================
# LaTeX 构建产物
# ============================================
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.nav
*.snm
*.vrb

# Overleaf 跨文档引用需要的 aux（例外保留）
!supplementary.aux

# ============================================
# 临时文件
# ============================================
*.tmp
*.temp
*_backup.*
*_old.*
